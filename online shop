SELECT 
    name,
    category,
    attributes->>'$.color' AS color,
    attributes->>'$.waterproof' AS waterproof,
    attributes->>'$.vegan' AS vegan
FROM products;

SELECT name, category
FROM products
WHERE attributes->>'$.vegan' = 'true';

SELECT name, price
FROM products
WHERE category = 'Electronics'
AND price < 100
AND attributes->>'$.waterproof' = 'true';

SELECT name, category
FROM products
WHERE attributes->>'$.color' = 'red';

SELECT category, COUNT(*) AS total
FROM products
GROUP BY category;

CREATE INDEX idx_vegan 
ON products ((attributes->>'$.vegan'));

ALTER TABLE products
ADD vegan_flag VARCHAR(5)
GENERATED ALWAYS AS (attributes->>'$.vegan') STORED;

CREATE INDEX idx_vegan_flag ON products(vegan_flag);

SELECT name
FROM products
WHERE attributes->'$.color' IS NULL;

SELECT name, JSON_PRETTY(attributes)
FROM products;

UPDATE products
SET attributes = JSON_SET(attributes, '$.color', 'blue')
WHERE name = 'T-Shirt';
