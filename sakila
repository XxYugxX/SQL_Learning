CREATE DATABASE sakila;

USE sakila;

SHOW DATABASES;

SELECT title, rental_rate 
FROM film 
WHERE rental_rate < (SELECT AVG(rental_rate) FROM film);

SELECT customer_id, COUNT(rental_id) AS rental_count 
FROM rental 
GROUP BY customer_id 
HAVING rental_count > 10;

SELECT a.first_name, a.last_name 
FROM actor a
JOIN film_actor fa ON a.actor_id = fa.actor_id
JOIN film f ON fa.film_id = f.film_id
WHERE f.length > 20;

SELECT c.name, COUNT(f.film_id) AS film_count 
FROM category c
JOIN film_category fc ON c.category_id = fc.category_id
JOIN film f ON fc.film_id = f.film_id
GROUP BY c.name 
HAVING film_count > (SELECT AVG(film_count) 
                     FROM (SELECT COUNT(film_id) AS film_count 
                           FROM film_category 
                           GROUP BY category_id) AS subquery);

SELECT c.customer_id, SUM(p.amount) AS total_spent 
FROM customer c
JOIN payment p ON c.customer_id = p.customer_id
GROUP BY c.customer_id 
HAVING total_spent > (SELECT AVG(total_spent)
                      FROM (SELECT SUM(amount) AS total_spent 
                            FROM payment 
                            GROUP BY customer_id) AS subquery);

SHOW TABLES;

DESCRIBE film;

DESCRIBE rental;

DESCRIBE customer;

DESCRIBE actor;

DESCRIBE category;
